      "kind": "warning",
      "severity": "warning",
      "scope": {
        "type": "system"
      },
      "recoverability": "automatic",
      "persistence": "until_resolved",
      "interruptiveness": "polite",
      "message": "You're offline. Reconnecting…",
      "agent": {
        "permissions": [
          "observe",
          "explain"
        ],
        "recommendedAction": "wait",
        "safeToRetry": true
      }
    },
