      "aliases": [
        "FORBIDDEN",
        "forbidden",
        "permission_denied",
        "ACCOUNT_SCOPE_REQUIRED",
        "CREDENTIAL_MODE_CONFLICT",
        "OPERATION_REQUIRES_SERVER_CREDENTIAL",
        "SITE_SECRET_BROWSER_USE_FORBIDDEN",
        "ACTOR_TYPE_FORBIDDEN",
        "ACCOUNT_ADMIN_REQUIRED",
        "USER_PRINCIPAL_REQUIRED"
      ],
      "kind": "error",
      "severity": "error",
      "recoverability": "admin_action",
      "persistence": "until_resolved",
      "title": "Access denied",
      "message": "You don't have permission to do that.",
      "agent": {
        "permissions": [
          "observe",
          "explain"
        ],
        "safeToRetry": false
      }
    },
